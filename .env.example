# submitcms — site (delivery) token'ı. Panel → Entegrasyon sekmesinde.
# Boş bırakılırsa site src/data/fallback.ts içindeki demo içerikle çalışır.
SUBMITCMS_TOKEN=
# production → https://live.submitcms.com | test → https://dev.submitcms.com
SUBMITCMS_MODE=production
# Self-hosted / yerel kurulum için API kökü (verilirse SUBMITCMS_MODE yok sayılır)
SUBMITCMS_API_URL=
# submitcms medya kütüphanesi kendi alan adındaysa (next/image remotePatterns)
SUBMITCMS_MEDIA_HOST=

# İletişim/rezervasyon talebinin ticket türü ve gönderen kimliği.
# Boş bırakılırsa sırasıyla "iletisim" ve gönderenin e-postası kullanılır.
SUBMITCMS_TICKET_TYPE=
SUBMITCMS_TICKET_USER=

# İçe aktarma script'i için panel oturumu (yalnızca scripts/submitcms-import.mjs).
# Çalışan sitede gerekmez; delivery tarafı oturum istemez.
SUBMITCMS_CONSOLE_EMAIL=
SUBMITCMS_CONSOLE_PASSWORD=

# İçerik önbelleğini elle düşüren uç (POST /api/yenile) için paylaşılan sır.
# Boş bırakılırsa uç kapalıdır; içerik 5 dakikada bir kendiliğinden tazelenir.
SUBMITCMS_REVALIDATE_SECRET=

# Olay/hata bildirimi — server-side only, NEXT_PUBLIC_ prefix'i KOYMA
SISTEMTAKIP_API_KEY=

# Kanonik adres (sitemap.xml ve metadata için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
